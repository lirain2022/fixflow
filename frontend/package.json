{
  "name": "fixflow-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev:system": "vite --config vite.system.config.js",
    "build:system": "vite build --config vite.system.config.js",
    "test:system": "vitest run --config vite.system.config.js",
    "test:e2e:system": "playwright test --config playwright.system.config.js"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "vite": "8.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "vitest": "5.0.1",
    "jsdom": "30.1.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@testing-library/jest-dom": "7.0.1",
    "@playwright/test": "1.63.0"
  }
}
